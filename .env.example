# ==============================================================================
# Mehfil (महफ़िल) Environment Configuration Example
# ==============================================================================
# Copy this file to `.env.local` to configure your local development environment:
#   cp .env.example .env.local
#
# Note: Mehfil is designed with resilient zero-config local fallbacks:
# - Without Google AI keys, it seamlessly uses the Tier 3 deterministic heuristic engine.
# - Without Supabase keys, it automatically falls back to local storage and offline auth.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Generative AI / Gemini API
# ------------------------------------------------------------------------------
# Required for:
#   - Tier 1: Google Gemma 4 (Style DNA extraction, layout curation)
#   - Tier 2: Gemini 2.0 Flash (Fast structured vision & quote analysis)
#
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
#
# Fallback: If not provided, Mehfil gracefully degrades to the pure TypeScript
# deterministic heuristic engine (Tier 3) with zero runtime errors.
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY= # Supported alias for GOOGLE_GENERATIVE_AI_API_KEY

# ------------------------------------------------------------------------------
# Supabase (Postgres & Anonymous Collaboration)
# ------------------------------------------------------------------------------
# Required for:
#   - Relational plan persistence, version history, and snapshot diffs
#   - Dual-link collaboration (read-only share links & capability-based edit keys)
#
# Obtain these from your Supabase project dashboard (Settings > API):
#   https://supabase.com/dashboard/project/_/settings/api
#
# Fallback: If unconfigured, Mehfil automatically falls back to browser localStorage
# and local session cookie authorization.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

