# ==============================================================================
# Mehfil (महफ़िल) Environment Configuration Example
# ==============================================================================
# Copy this file to `.env.local` to configure your local development environment:
#   cp .env.example .env.local
#
# Note: Mehfil is designed with resilient zero-config local fallbacks:
# - Without Google AI keys, it seamlessly uses the Tier 3 deterministic heuristic engine.
# - Without Supabase keys, it automatically falls back to local storage and offline auth.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Generative AI / Gemini API
# ------------------------------------------------------------------------------
# Required for:
#   - Tier 1: Google Gemma 4 (Style DNA extraction, layout curation)
#   - Tier 2: Gemini 3.5 Flash Lite (Fast structured vision & quote analysis)
#
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
#
# Fallback: If not provided, Mehfil gracefully degrades to the pure TypeScript
# deterministic heuristic engine (Tier 3) with zero runtime errors.
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY= # Supported alias for GOOGLE_GENERATIVE_AI_API_KEY

# ------------------------------------------------------------------------------
# Supabase (Postgres & Anonymous Collaboration)
# ------------------------------------------------------------------------------
# Required for:
#   - Relational plan persistence, version history, and snapshot diffs
#   - Dual-link collaboration (read-only share links & capability-based edit keys)
#
# Obtain these from your Supabase project dashboard (Settings > API):
#   https://supabase.com/dashboard/project/_/settings/api
#
# Apply every file in supabase/migrations/ to the project (`supabase db push`) before use.
# The browser reaches the data only through the token-checked functions in
# 20261031000000_token_checked_access.sql (ADR-0010).
#
# Fallback: If unconfigured, Mehfil keeps plans in browser localStorage. Edit links and
# family share links need the database, so they are unavailable in that mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# Server limits
# ------------------------------------------------------------------------------
# SERVER-ONLY key that makes the abuse limits shared across every server instance (ADR-0011).
# Copy it from Settings > API > service_role. It bypasses row-level security, so NEVER give it a
# NEXT_PUBLIC_ prefix and never commit it. It is used for two counter functions and nothing else.
# Without it, the same limits still apply but are counted per instance, which is exact locally.
SUPABASE_SERVICE_ROLE_KEY=

# Daily ceiling on paid model calls. Past it, requests use the deterministic Tier 3 path.
# Default 300. With SUPABASE_SERVICE_ROLE_KEY set this is one count for the whole deployment;
# without it, each server instance counts for itself. Also set a spend limit in the Google AI
# console.
# MODEL_DAILY_CAP=300

# Log verbosity: debug | info | warn | error | silent (default info; silent under tests).
# LOG_LEVEL=info
